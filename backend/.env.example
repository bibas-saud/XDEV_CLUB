# Copy this file to .env and fill in your real values.
# NEVER commit .env — it contains secrets.

# ═══ DATABASE (Supabase Postgres) ═══
# Dashboard → Project Settings → Database
# URL-encode special characters in the password: @ -> %40, : -> %3A, / -> %2F
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# ═══ BOOTSTRAP ADMIN ═══
# Created once by `uv run python -m app.scripts.admin_bootstrap`
# This is the ONE account that logs into the website. Login happens by EMAIL.
ADMIN_NAME=admin
ADMIN_EMAIL=your_email@example.com
ADMIN_PASSWORD=your_strong_password

# ═══ AUTHENTICATION (JWT) ═══
# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_random_secret
# How long a login session lasts, in minutes (1440 = 24 hours)
JWT_EXPIRES_MINUTES=1440

# ═══ CORS ═══
# Comma-separated list of allowed frontend origins, e.g. ["https://xdev-club.vercel.app"]
CORS_ORIGINS=[]

# ═══ SUPABASE STORAGE ═══
# Dashboard → Project Settings → API
# The secret key bypasses all storage policies — server-side ONLY, never expose to the frontend.
SUPABASE_PROJECT_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=your_secret_key
# PUBLIC bucket: member photos, served on the website
SUPABASE_PHOTOS_BUCKET=members
# PRIVATE bucket: generated ID cards, admin-only via signed URLs
SUPABASE_ID_CARDS_BUCKET=id-cards
# PUBLIC bucket: event photos and videos
SUPABASE_EVENTS_BUCKET=events

# ═══ EMAIL / SMTP (ownership transfer invitations) ═══
# Example (Gmail): create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# ═══ OWNERSHIP TRANSFER ═══
# Public URL of the frontend — used to build invitation accept links.
# REQUIRED for sending invitations.
FRONTEND_BASE_URL=https://your-frontend-domain.com
# How long a transfer invitation stays valid, in hours
INVITE_EXPIRY_HOURS=48
